"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Subject</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Verb to be</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Verb(+ing) </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"am\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"sending\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"are\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"staying\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "I am sending the invitation."}, {"type": "example", "content": "You are staying with me."}, {"type": "text", "content": "With some verbs, you need to change the spelling when you add <span class=\"strong\">-ing</span>. "}, {"type": "text", "content": "Here are the rules:"}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Verb ending in... </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">How to make the -ing form </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Examples </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"one vowel + one consonant\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"double the consonant, then add - ing\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"sit - sitting\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"one vowel + one consonant + E or Y\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"remove E or Y, then add -ing\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"leave - leaving\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to start   "}, {"type": "definition", "content": "to begin to do something "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: It is starting to drizzle."}, {"type": "audio", "content": "engenn2le03ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you hear in a conversation about e-mails."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "umbrella "}, {"type": "definition", "content": "a thing we use to cover ourselves from the rain "}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: It is raining. Do you have an umbrella?"}, {"type": "audio", "content": "engenn2le03ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "shower "}, {"type": "definition", "content": "a small amount of rain for a short time"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: It is raining ... maybe it is only a shower."}, {"type": "audio", "content": "engenn2le03ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to leave "}, {"type": "definition", "content": "to go away from a place "}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: My yoga class is soon. I am leaving in a minute."}, {"type": "audio", "content": "engenn2le03ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to stay "}, {"type": "definition", "content": "to remain in a place; to not leave "}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: It is raining. I am staying here!"}, {"type": "audio", "content": "engenn2le03ob08aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "inside "}, {"type": "definition", "content": "located in something or so