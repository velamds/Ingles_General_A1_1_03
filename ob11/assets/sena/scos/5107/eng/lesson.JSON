{"_data": [{"type": "metadata", "contents": [{"content": "At the Coffee Shop", "type": "lesson_name"}, {"content": "The Party ", "type": "unit_name"}, {"content": 11, "type": "position"}, {"content": "scholar > How to Master Small Talk > Meeting Electra", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about people, their likes and dislikes, homes or countries in communicative situations. ", "type": "primary"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_1"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_2"}, {"content": " Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_3"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_4"}, {"content": " Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": " Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_6"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_7"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "Review of Possessive Pronouns and Adjectives", "type": "heading"}, {"content": "Compare possessive adjectives and pronouns in this chart:", "type": "describer"}, {"content": "{\"rows\":\"07\",\"columns\":\"03\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Possessive Adjectives </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Possessive Pronouns </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"I\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's my juice.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's mine.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That's your coffee.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"That coffee is yours.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's his computer.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The computer is his.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"She\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's her bag. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The bag is hers.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"We\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Those are our books.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Those books are ours.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It's their car.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"The car is theirs.\\\"}\"],\"styles\":\" instruction_table_background\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": "Review of the Present Continuous", "type": "heading"}, {"content": "You use the Present Continuous tense to talk about current actions.", "type": "describer"}, {"content": "Current actions are things that are happening NOW.  <br/><br/>Remember, to ask questions, you use phrases like:", "type": "text"}, {"content": "  What <span class=\"strong\">is</span> he do<span class=\"strong\">ing</span>?<br /> What <span class=\"strong\">is</span> your mother do<span class=\"strong\">ing</span>?", "type": "text"}, {"content": "You make the Present Continuous tense negative by adding  <span class=\"strong\">not</span> after the verb  <span class=\"strong\">to be</span> and before the  <span class=\"strong\">verb-ing</span>.", "type": "text"}, {"content": "I am not looking for anything right now. ", "type": "example"}, {"content": "He is not eating dinner. ", "type": "example"}, {"content": "She isn't playing video games.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to borrow ", "type": "name"}, {"content": "to take something from someone and give it back later ", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: Can I borrow some money?", "type": "example"}, {"content": "engenn2le03ob11aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are the words to review. ", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "inside ", "type": "name"}, {"content": "located in something or some place", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: It is raining ... I'm staying inside.", "type": "example"}, {"content": "engenn2le03ob11aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "same ", "type": "name"}, {"content": "exactly like another", "type": "definition"}, {"content": "(adjective) ", "type": "part_speech"}, {"content": "Example: We are in the same class.", "type": "example"}, {"content": "engenn2le03ob11aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "blonde/blond ", "type": "name"}, {"content": "yellow color, used for hair", "type": "definition"}, {"content": "(adjective)  ", "type": "part_speech"}, {"content": " Example: She has blonde hair.", "type": "example"}, {"content": "engenn2le03ob11aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "party ", "type": "name"}, {"content": "a social event where people eat, drink or dance ", "type": "definition"}, {"content": "(noun)  ", "type": "part_speech"}, {"content": "Example: Do you want to come to the party?", "type": "example"}, {"content": "engenn2le03ob11aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to have to   ", "type": "name"}, {"content": "to need to; must ", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I have to meet a friend.", "type": "example"}, {"content": "engenn2le03ob11aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "maybe ", "type": "name"}, {"content": "possibly ", "type": "definition"}, {"content": "(adverb)  ", "type": "part_speech"}, {"content": "Example: <span class=\"strong\">Tom</span>:      Can you come to the party? <br><span class=\"strong\">Trisha</span>:      Maybe ...", "type": "example"}, {"content": "engenn2le03ob11aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to stay  ", "type": "name"}, {"content": "to remain in a place; to not leave ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: It is raining. I am staying here!", "type": "example"}, {"content": "engenn2le03ob11aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "just kidding ", "type": "name"}, {"content": "you say this after you make a joke ", "type": "definition"}, {"content": "(expression)  ", "type": "part_speech"}, {"content": "Example:  Your notes are bad! Just kidding!", "type": "example"}, {"content": "engenn2le03ob11aud09", "type": "audio"}]}, {"content": "engenn2le03ob11re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Choose a role from the table below.", "type": "text"}, {"content": "Read your situation out loud.", "type": "text"}, {"content": "Write a dialogue (4-6 lines) with your partner.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role&nbsp;1:</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You are not going to the party. Your friend calls. Tell them why you are not going to the party.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role&nbsp;2:</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Your friend is not at the party. Call them and ask them where they are.\\\"}\"],\"styles\":\"\"}", "type": "table"}, {"content": "Read your dialogue aloud with your partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I choose a role card.", "type": "text"}, {"content": "I read my role out loud. ", "type": "text"}, {"content": "I write a dialogue about things happening at the present.", "type": "text"}, {"content": "I read my dialogue out loud with my partner.", "type": "text"}]}], "labs": [{"stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le03ob11re2aud01", "images": [{"image": "engenn2le03ob11re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le03ob11re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Peter</span>:      Hey, John. What are you doing?<br />\n<span class=\"strong\">John</span>:      Hey, Peter. I'm getting a drink. Why don't I get one for you?<br />\n<span class=\"strong\">Peter</span>:      This is mine, thanks. Hmm ... where is Vanessa?", "time": "100"}, {"image": "engenn2le03ob11re2img05.jpg", "id": 2, "text": "<span class=\"strong\">John</span>:      Vanessa? Oh, right. The woman you met.<br />\n<span class=\"strong\">Peter</span>:      Can I borrow your phone? I want to call her.<br />\n<span class=\"strong\">John</span>:      Where's yours? Just kidding. Sure, here.", "time": "13000"}, {"image": "engenn2le03ob11re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>:      Hello?<br />\n<span class=\"strong\">Peter</span>:      Hi, it's Peter. <br />\n<span class=\"strong\">Vanessa</span>:      Oh, hi Peter. I'm not coming to the party, sorry.<br />\n<span class=\"strong\">Peter</span>:      Oh. Why not?", "time": "32000"}, {"image": "engenn2le03ob11re2img01.jpg", "id": 4, "text": "<span class=\"strong\">Vanessa</span>:      It's raining and I want to stay inside. My cousin, Natalie, is here, too. She's cooking dinner.<br />\n<span class=\"strong\">Peter</span>:      Natalie? I met a Natalie in my class. What does she look like?<br />\n<span class=\"strong\">Vanessa</span>:      She has blonde hair.", "time": "45000"}, {"image": "engenn2le03ob11re2img01.jpg", "id": 5, "text": "<span class=\"strong\">Peter</span>:      Oh, it's not the same Natalie. Well, I have to go.<br />\n<span class=\"strong\">Vanessa</span>:      Why don't we meet tomorrow?<br />\n<span class=\"strong\">Peter</span>:      Maybe ... Bye.<br />\n<span class=\"strong\">Vanessa</span>:      OK. Bye.<br />", "time": "60000"}], "coverimg": "engenn2le03ob11re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "_data": [{"type": "instructions", "contents": [{"content": "I can talk about what people do and what people are doing.", "type": "Learning Outcomes"}, {"content": "I can express possession.", "type": "Learning Outcomes"}, {"content": "I can ask and say what people are doing.", "type": "Learning Outcomes"}, {"content": "What do you like to do in your free time? ", "type": "Free Header Item"}, {"content": "What are your friends doing right now?", "type": "Free 