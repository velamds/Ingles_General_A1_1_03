{"_data": [{"type": "metadata", "contents": [{"content": "At the Coffee Shop", "type": "lesson_name"}, {"content": "It's a Rainy Day", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "scholar > Daily Life > Times and Dates", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about free-time activities or personal likes/dislikes in communicative situations. ", "type": "primary"}, {"content": "Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_2"}, {"content": "Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands key information  in written texts about the communicative topics related to this level.", "type": "secondary_6"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_7"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " The Present Simple Tense and the Present Continuous Tense", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "I play soccer every day.", "type": "example"}, {"content": "You use the Present Simple tense to talk about routines - things that don't change.", "type": "text"}, {"content": "You use the Present Continuous tense to talk about actions that are happening now.", "type": "text"}, {"content": "I am playing soccer now.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Review of Asking and Telling the Time", "type": "heading"}, {"content": " ", "type": "describer"}, {"content": "You use this question to ask a person about the time:", "type": "text"}, {"content": "<span class=\"strong\">Ann</span>: What time is it?     <br />  <span class=\"strong\">Tom</span>:      It is 5 p.m.", "type": "text"}, {"content": "You can also use the Wh- question word <span class=\"italic\">when</span>:", "type": "text"}, {"content": "<span class=\"strong\">Ann</span>: When is the meeting?   <br />  <span class=\"strong\">Tom</span>:     It is at 10 a.m.", "type": "text"}, {"content": "Look at the chart for saying the time at different times of the day.", "type": "text"}, {"content": "{\"rows\":\"05\",\"columns\":\"02\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Time Word\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Time of Day</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"noon \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"12 o'clock in the afternoon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"midnight \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"12 o'clock at night\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a.m. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the time between midnight and noon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"p.m.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the time between noon and midnight\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "It's noon. I'm hungry.", "type": "example"}, {"content": "It's midnight. I have to go to sleep.", "type": "example"}, {"content": "The school starts at 9 a.m.", "type": "example"}, {"content": "I have dinner at 8 p.m.", "type": "example"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use in conversations with friends.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "soon   ", "type": "name"}, {"content": "quickly; in a short time ", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: I have to meet my friend soon.", "type": "example"}, {"content": "engenn2le03ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "timetable ", "type": "name"}, {"content": "a list of times when something happens; schedule ", "type": "definition"}, {"content": "(noun)  ", "type": "part_speech"}, {"content": "Example: Can I see the bus timetable?", "type": "example"}, {"content": "engenn2le03ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "schedule ", "type": "name"}, {"content": "a list of planned activities; timetable ", "type": "definition"}, {"content": "(noun)  ", "type": "part_speech"}, {"content": "Example: I have the train schedule.", "type": "example"}, {"content": "engenn2le03ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "party ", "type": "name"}, {"content": "a social event where people eat, drink or dance ", "type": "definition"}, {"content": "(noun)  ", "type": "part_speech"}, {"content": "Example: Do you want to come to the party?", "type": "example"}, {"content": "engenn2le03ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "with ", "type": "name"}, {"content": "together ", "type": "definition"}, {"content": "(preposition)  ", "type": "part_speech"}, {"content": "Example: Come to the party with me.", "type": "example"}, {"content": "engenn2le03ob09aud06", "type": "audio"}]}, {"content": "engenn2le03ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Choose a role card from the table below.", "type": "text"}, {"content": "Read your situation.", "type": "text"}, {"content": "Write a dialogue (4-6 lines) with your partner.", "type": "text"}, {"content": "Switch roles.", "type": "text"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role 1: </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You are late to meet a friend. Ask what time it is. Say goodbye.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role 2:</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Your friend is late to meet someone. Tell them the time. Say goodbye.\\\"}\"],\"styles\":\"\"}", "type": "table"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I choose a role", "type": "text"}, {"content": "I ask or tell the time.", "type": "text"}, {"content": "I write a dialogue about what people are doing.", "type": "text"}]}], "labs": [{"stimuli": [{"id": 0, "type": "welcome", "contents": [{}], "_data": [], "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn2le03ob09re2aud01", "images": [{"image": "engenn2le03ob09re2img05.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn2le03ob09re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: It's still raining. I'm having another coffee.\n<br />\n<span class=\"strong\">Peter</span>: Good idea. You're drinking decaf anyway.", "time": "100"}, {"image": "engenn2le03ob09re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Peter</span>: What time is it?\n<br /><span class=\"strong\">Vanessa</span>: It's 2:30.\n<br /><span class=\"strong\">Peter</span>: 2:30! Oh, no!\n<br /><span class=\"strong\">Vanessa</span>: What?\n<br /><span class=\"strong\">Peter</span>: I have to meet a friend.", "time": "7500"}, {"image": "engenn2le03ob09re2img01.jpg", "id": 3, "text": "<span class=\"strong\">Vanessa</span>: Are you late?\n<br /><span class=\"strong\">Peter</span>: No, but I have to meet him soon. Do you have the bus schedule?\n<br /><span class=\"strong\">Vanessa</span>: No. I only have the train timetable. Here.", "time": "18000"}, {"image": "engenn2le03ob09re2img01.jpg", "id": 4, "text": "<span class=\"strong\">Peter</span>: Thanks. There is a party later. Want to come with me?\n<br /><span class=\"strong\">Vanessa</span>: Are you inviting me? Cool! What time is the party?\n<br /><span class=\"strong\">Peter</span>: 8 o'clock.", "time": "29600"}, {"image": "engenn2le03ob09re2img02.jpg", "id": 5, "text": "<span class=\"strong\">Vanessa</span>: I can meet you there.\n<br /><span class=\"strong\">Peter</span>: Great! What is your e-mail address? Mine is peter.smith@mail.com.", "time": "40000"}, {"image": "engenn2le03ob09re2img02.jpg", "id": 6, "text": "<span class=\"strong\">Vanessa</span>: Mine is Vanessa.rocks@mail.com. My number is 555-6869.\n<br /><span class=\"strong\">Peter</span>: How do you spell your name?", "time": "52000"}, {"image": "engenn2le03ob09re2img02.jpg", "id": 7, "text": "<span class=\"strong\">Vanessa</span>: V-A-N-E-S-S-A.\n<br /><span class=\"strong\">Peter</span>: OK! See you later!", "time": "68000"}], "coverimg": "engenn2le03ob09re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}], "exercises": [{"id": 0, "template_override": 1, "stimuli_ids": [0], "_data": [{"type": "instructions", "contents": [{"content": "I can talk about what people do.", "type": "Learning Outcomes"}, {"content": "I can ask and say what people are doing.", "type": "Learning Outcomes"}, {"content": "I can ask for and tell the time.", "type": "Learning Outcomes"}, {"content": "What time do you eat breakfast? ", "type": "Free Header