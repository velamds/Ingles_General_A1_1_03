: [{"type": "text", "content": "Oh, no! You are late to meet a friend. "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": "You have 2 tries."}, {"type": "text", "content": "You have 1 attempt left."}], "incorrect_feedback": [{"type": "text", "content": "Try again."}, {"type": "text", "content": "Maybe next time\u2026"}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}], "template_override": 1}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "At the Coffee Shop"}, {"type": "unit_name", "content": "It's a Rainy Day"}, {"type": "position", "content": 9}, {"type": "origin", "content": "scholar > Daily Life > Times and Dates"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about free-time activities or personal likes/dislikes in communicative situations. "}, {"type": "secondary_1", "content": "Understands key information  in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_3", "content": "Understands key information  in written texts about the communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands key information  in written texts about the communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands key information  in written texts about the communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands key information  in written texts about the communicative topics related to this level."}, {"type": "secondary_7", "content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_8", "content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " The Present Simple Tense and the Present Continuous Tense"}, {"type": "describer", "content": " "}, {"type": "example", "content": "I play soccer every day."}, {"type": "text", "content": "You use the Present Simple tense to talk about routines - things that don't change."}, {"type": "text", "content": "You use the Present Continuous tense to talk about actions that are happening now."}, {"type": "example", "content": "I am playing soccer now."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Review of Asking and Telling the Time"}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use this question to ask a person about the time:"}, {"type": "text", "content": "<span class=\"strong\">Ann</span>: What time is it?     <br />  <span class=\"strong\">Tom</span>:      It is 5 p.m."}, {"type": "text", "content": "You can also use the Wh-question word <span class=\"italic\">when</span>:"}, {"type": "text", "content": "<span class=\"strong\">Ann</span>: When is the meeting?   <br />  <span class=\"strong\">Tom</span>:     It is at 10 a.m."}, {"type": "text", "content": "Look at the chart for saying the time at different times of the day."}, {"type": "table", "content": "{\"rows\":\"05\",\"columns\":\"02\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"o'clock \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"use this to tell the time \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"noon \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"12 o'clock in the afternoon\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"midnight \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"12 o'clock at night\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a.m. \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the time between midnight and noon.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"p.m.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"the time between noon and midnight.\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "It's noon. I'm hungry."}, {"type": "example", "content": "It's midnight. I have to go to sleep."}, {"type": "example", "content": "The school starts at 9 a.m."}, {"type": "example", "content": "I have dinner at 8 p.m."}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use in conversations with friends."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "soon   "}, {"type": "definition", "content": "quickly; in a short time "}, {"type": "part_speech", "content": "(adverb)"}, {"type": "example", "content": "Example: I have to meet my friend soon."}, {"type": "audio", "content": "engenn2le03ob09aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "timetable "}, {"type": "definition", "content": "a list of times when something happens; schedule "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: Can I see the bus timetable?"}, {"type": "audio", "content": "engenn2le03ob09aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "schedule "}, {"type": "definition", "content": "a list of planned activities; timetable "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: I have the train schedule."}, {"type": "audio", "content": "engenn2le03ob09aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "party "}, {"type": "definition", "content": "a social event where people eat, drink or dance "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: Do you want to come to the party?"}, {"type": "audio", "content": "engenn2le03ob09aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "with "}, {"type": "definition", "content": "together "}, {"type": "part_speech", "content": "(preposition)  "}, {"type": "example", "content": "Example: Come to the party with me."}, {"type": "audio", "content": "engenn2le03ob09aud06"}]}, {"type": "background_image", "content": "engenn2le03ob09re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Choose a role from the role card."}, {"type": "text", "content": "Read your situation."}, {"type": "text", "content": "Write a dialogue (4-6 lines) with your partner."}, {"type": "text", "content": "Switch roles"}, {"type": "table", "content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role 1: </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You are late to meet a friend. Ask what time it is. Say goodbye.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Role 2:</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Your friend is late to meet someone. Tell them the time. Say goodbye.\\\"}\"],\"styles\":\"\"}"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I ask what time it is."}, {"type": "text", "content": "I tell the time."}, {"type": "text", "content": "I talk about what people are doing."}]}], "type": "sena"}