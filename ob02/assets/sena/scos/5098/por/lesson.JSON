uum  "}, {"type": "definition", "content": "to clean the floor and carpet with a machine "}, {"type": "part_speech", "content": "(verb) "}, {"type": "example", "content": "Example: The floor is dirty. Please vacuum it. "}, {"type": "audio", "content": "engenn2le03ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "noisy "}, {"type": "definition", "content": "too many sounds or voices"}, {"type": "part_speech", "content": "(adjective) "}, {"type": "example", "content": "Example: My house is too noisy. I study at the library."}, {"type": "audio", "content": "engenn2le03ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "quiet  "}, {"type": "definition", "content": "making no noise; not noisy "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The library is quiet. I like to study there."}, {"type": "audio", "content": "engenn2le03ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "place "}, {"type": "definition", "content": "location; area "}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: The caf\u00e9 is a nice place to study too."}, {"type": "audio", "content": "engenn2le03ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "homework "}, {"type": "definition", "content": "student work to complete at home "}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example:  My homework is very difficult. "}, {"type": "audio", "content": "engenn2le03ob02aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "internet "}, {"type": "definition", "content": "a computer network of information "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: The internet is fun to use. I learn a lot."}, {"type": "audio", "content": "engenn2le03ob02aud08"}]}, {"type": "target_word", "contents": [{"type": "n